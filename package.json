    "jsqr": "^1.4.0",
    "oxlint": "^1.91.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
