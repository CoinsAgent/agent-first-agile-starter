    "better-auth": "^1.7.15",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "get-nonce": "^1.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.15",
    "wagmi": "^3.7.11",
    "zod": "^4.6.7"
