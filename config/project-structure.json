{
  "version": 1,
  "description": "Adopted US-001-05 layout: source directly under frontend/backend, with unchanged explicit responsibilities. app = composition, feature = domain, shared = generic independent code. Future domains remain declarations only.",
  "source_roots": [
    "frontend",
    "backend",
    "shared"
  ],
  "aliases": {
    "@/": "frontend"
  },
  "owners": [
    {
      "path": "frontend/index.html",
      "kind": "file",
      "role": "app",
      "runtime": "browser"
    },
    {
      "path": "shared/contracts",
      "kind": "directory",
      "role": "shared",
      "runtime": "neutral"
    },
    {
      "path": "frontend/main.tsx",
      "kind": "file",
      "role": "app",
      "runtime": "browser"
    },
    {
      "path": "frontend/bootstrap",
      "kind": "directory",
      "role": "app",
      "runtime": "browser"
    },
    {
      "path": "frontend/pages",
      "kind": "directory",
      "role": "app",
      "runtime": "browser"
    },
    {
      "path": "frontend/wallet-auth",
      "kind": "directory",
      "role": "feature",
      "feature": "wallet-browser",
      "runtime": "browser"
    },
    {
      "path": "frontend/authorization",
      "kind": "directory",
      "role": "feature",
      "feature": "authorization-browser",
      "runtime": "browser"
    },
    {
      "path": "frontend/applications",
      "kind": "directory",
      "role": "feature",
      "feature": "applications-browser",
      "runtime": "browser"
    },
    {
      "path": "frontend/ui",
      "kind": "directory",
      "role": "shared",
      "runtime": "browser"
    },
    {
      "path": "frontend/lib",
      "kind": "directory",
      "role": "shared",
      "runtime": "browser"
    },
    {
      "path": "frontend/assets",
      "kind": "directory",
      "role": "shared",
      "runtime": "browser"
    },
    {
      "path": "frontend/styles",
      "kind": "directory",
      "role": "shared",
      "runtime": "browser"
    },
    {
      "path": "backend/index.ts",
      "kind": "file",
      "role": "app",
      "runtime": "server"
    },
    {
      "path": "backend/bootstrap",
      "kind": "directory",
      "role": "app",
      "runtime": "server"
    },
    {
      "path": "backend/wallet-auth",
      "kind": "directory",
      "role": "feature",
      "feature": "wallet-server",
      "runtime": "server"
    },
    {
      "path": "backend/oidc",
      "kind": "directory",
      "role": "feature",
      "feature": "oidc-server",
      "runtime": "server"
    },
    {
      "path": "backend/applications",
      "kind": "directory",
      "role": "feature",
      "feature": "applications-server",
      "runtime": "server"
    },
    {
      "path": "backend/infrastructure",
      "kind": "directory",
      "role": "shared",
      "runtime": "server"
    }
  ],
  "feature_roots": [],
  "public_interfaces": [
    "frontend/wallet-auth/index.ts",
    "frontend/authorization/index.ts",
    "frontend/applications/index.ts",
    "backend/wallet-auth/index.ts",
    "backend/oidc/index.ts",
    "backend/applications/index.ts"
  ],
  "repository_areas": {
    "frontend": "React mounting/bootstrap/pages, wallet-auth domain and generic ui/lib/assets/styles",
    "backend": "Node.js entry/bootstrap, wallet-auth domain and generic infrastructure",
    "shared": "Proposed runtime-neutral contracts",
    "tests": "Harness, application and browser tests; production dependency rules do not forbid test access to internals",
    "scripts": "Automation and verification",
    "config": "Structure declarations and finite dependency baseline",
    ".github": "CI/review and trusted scope policy",
    ".agents": "Agent workflow skills",
    ".vscode": "Existing editor configuration; not application source",
    "docs": "Product, design, structure, process and development guides",
    "backlog": "Story map and authoritative lifecycle records",
    "work": "Per-story execution plans/evidence; historical tracked artifacts",
    "root_files": "Package/lock, tool and entry configuration, environment templates, README, license/ignore files and AGENTS instructions; individual files still require approved scope"
  },
  "root_files": [
    ".env.example",
    ".gitignore",
    ".npmrc",
    "AGENTS.md",
    "README.md",
    "components.json",
    "package-lock.json",
    "package.json",
    "playwright.config.ts",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "skills-lock.json"
  ],
  "non_source": [
    "node_modules",
    "dist",
    "data",
    "test-results",
    "playwright-report",
    ".env"
  ]
}
